# Copy this file to .env and fill in your values

# Groq
GROQ_API_KEY="your-data-here"

# BAP PostgreSQL (postgres-bap container — buyer side, port 5434)
BAP_DB_NAME="bap_db"
BAP_DB_USER="bap_user"
BAP_DB_PASSWORD="your-data-here"

# BPP PostgreSQL (postgres-bpp container — provider side, port 5435)
BPP_DB_NAME="bpp_db"
BPP_DB_USER="bpp_user"
BPP_DB_PASSWORD="your-data-here"