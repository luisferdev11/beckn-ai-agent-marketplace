# Copy this file to .env and fill in your values

# Groq (used by planner :3010 and orchestrator2 :3008)
GROQ_API_KEY="your-groq-api-key-here"

# Google (used by agents)
GOOGLE_API_KEY="your-google-api-key-here"

# BAP PostgreSQL (postgres-bap container — buyer side, port 5434)
BAP_DB_NAME="bap_db"
BAP_DB_USER="bap_user"
BAP_DB_PASSWORD="your-bap-db-password-here"

# BPP PostgreSQL (postgres-bpp container — provider side, port 5435)
BPP_DB_NAME="bpp_db"
BPP_DB_USER="bpp_user"
BPP_DB_PASSWORD="your-bpp-db-password-here"

# Mock-network PostgreSQL (postgres-mocknet container — DeDi/CDS state + Registry, port 5436)
# Uses pgvector image because the catalog index needs vector columns later (Pieza 1).
MOCKNET_DB_NAME="mocknet_db"
MOCKNET_DB_USER="mocknet_user"
MOCKNET_DB_PASSWORD="your-data-here"

# Catalog PostgreSQL (postgres-catalog container — frontend publisher/admin data, port 5437)
# Hosts beckn_catalog DB (providers, agents, agent_stats).
# DB_NAME_CATALOG and DB_NAME_METRICS both point here so single-pool JOINs work.
CATALOG_DB_NAME="beckn_catalog"
CATALOG_DB_USER="catalog_user"
CATALOG_DB_PASSWORD="your-catalog-db-password-here"
