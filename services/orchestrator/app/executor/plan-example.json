{
  "goal": "Procesar una reseña negativa en inglés: traducirla al español para el equipo, analizar su sentimiento, clasificar el tipo de queja, y generar 3 preguntas de seguimiento para customer service.",

  "userInput": {
    "review": "I ordered the product 3 weeks ago and it still hasn't arrived. The customer service was rude when I called. I want my money back!"
  },

  "agents": [
    {
      "agent_name": "language-translator-agent",
      "label": "Language Translator",
      "description": "Agente que traduce texto al idioma destino indicado y reporta el idioma de origen detectado.",
      "endpoint": "http://localhost:3011/agents/translator",
      "method": "POST",
      "inputSchema": {
        "type": "object",
        "examples": [
          {
            "type": "object",
            "properties": {
              "text": { "type": "string" },
              "targetLang": {
                "type": "string",
                "description": "ISO 639-1 language code (e.g. 'en', 'es', 'fr', 'ja')"
              }
            },
            "required": ["text", "targetLang"]
          }
        ]
      },
      "outputSchema": {
        "type": "object",
        "examples": [
          {
            "type": "object",
            "properties": {
              "translation": { "type": "string" },
              "detectedSourceLang": {
                "type": "string",
                "description": "ISO 639-1 code of the detected source language"
              }
            },
            "required": ["translation", "detectedSourceLang"]
          }
        ]
      },
      "skills": [
        {
          "id": "translation",
          "description": "Translate text between natural languages preserving meaning and tone",
          "inputModes": ["text"],
          "outputModes": ["text"]
        },
        {
          "id": "source-language-detection",
          "description": "Identify the original language of the input text automatically",
          "inputModes": ["text"],
          "outputModes": ["text"]
        }
      ],
      "capabilities": {
        "modalities": ["text"],
        "streaming": false
      }
    },

    {
      "agent_name": "sentiment-analyzer-agent",
      "label": "Sentiment Analyzer",
      "description": "Agente que clasifica la polaridad emocional de un texto y produce un score numérico junto con la justificación de la decisión.",
      "endpoint": "http://localhost:3011/agents/sentiment",
      "method": "POST",
      "inputSchema": {
        "type": "object",
        "examples": [
          {
            "type": "object",
            "properties": {
              "text": { "type": "string" }
            },
            "required": ["text"]
          }
        ]
      },
      "outputSchema": {
        "type": "object",
        "examples": [
          {
            "type": "object",
            "properties": {
              "sentiment": {
                "type": "string",
                "enum": ["positive", "negative", "neutral"]
              },
              "score": {
                "type": "number",
                "minimum": -1,
                "maximum": 1
              },
              "reasoning": { "type": "string" }
            },
            "required": ["sentiment", "score"]
          }
        ]
      },
      "skills": [
        {
          "id": "sentiment-classification",
          "description": "Assign a polarity label (positive / negative / neutral) to a text",
          "inputModes": ["text"],
          "outputModes": ["text"]
        },
        {
          "id": "polarity-scoring",
          "description": "Produce a continuous score in [-1, 1] representing emotional intensity",
          "inputModes": ["text"],
          "outputModes": ["text"]
        },
        {
          "id": "rationale-generation",
          "description": "Explain in natural language why the classification was assigned",
          "inputModes": ["text"],
          "outputModes": ["text"]
        }
      ],
      "capabilities": {
        "modalities": ["text"],
        "streaming": false
      }
    },

    {
      "agent_name": "category-classifier-agent",
      "label": "Category Classifier",
      "description": "Agente que asigna un texto a UNA categoría entre un conjunto provisto por el usuario, devolviendo confianza y alternativas rankeadas.",
      "endpoint": "http://localhost:3011/agents/classifier",
      "method": "POST",
      "inputSchema": {
        "type": "object",
        "examples": [
          {
            "type": "object",
            "properties": {
              "text": { "type": "string" },
              "categories": {
                "type": "array",
                "items": { "type": "string" },
                "minItems": 2
              }
            },
            "required": ["text", "categories"]
          }
        ]
      },
      "outputSchema": {
        "type": "object",
        "examples": [
          {
            "type": "object",
            "properties": {
              "category": { "type": "string" },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "alternatives": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "category": { "type": "string" },
                    "confidence": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  },
                  "required": ["category", "confidence"]
                }
              }
            },
            "required": ["category", "confidence"]
          }
        ]
      },
      "skills": [
        {
          "id": "multi-class-classification",
          "description": "Pick the best matching label from a user-provided set of N categories",
          "inputModes": ["text"],
          "outputModes": ["text"]
        },
        {
          "id": "confidence-scoring",
          "description": "Attach a calibrated confidence value to the chosen label",
          "inputModes": ["text"],
          "outputModes": ["text"]
        },
        {
          "id": "alternative-ranking",
          "description": "Return the remaining categories ordered by descending confidence",
          "inputModes": ["text"],
          "outputModes": ["text"]
        }
      ],
      "capabilities": {
        "modalities": ["text"],
        "streaming": false
      }
    },

    {
      "agent_name": "question-generator-agent",
      "label": "Question Generator",
      "description": "Agente que genera preguntas de comprensión a partir de un texto fuente, controlando la cantidad, el tipo y la dificultad de cada una.",
      "endpoint": "http://localhost:3011/agents/questioner",
      "method": "POST",
      "inputSchema": {
        "type": "object",
        "examples": [
          {
            "type": "object",
            "properties": {
              "text": { "type": "string" },
              "count": { "type": "integer", "default": 5 },
              "difficulty": {
                "type": "string",
                "enum": ["easy", "medium", "hard"],
                "default": "medium"
              }
            },
            "required": ["text"]
          }
        ]
      },
      "outputSchema": {
        "type": "object",
        "examples": [
          {
            "type": "object",
            "properties": {
              "questions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "question": { "type": "string" },
                    "type": {
                      "type": "string",
                      "enum": ["factual", "inferential", "analytical", "open-ended"]
                    },
                    "difficulty": {
                      "type": "string",
                      "enum": ["easy", "medium", "hard"]
                    }
                  },
                  "required": ["question", "type", "difficulty"]
                }
              }
            },
            "required": ["questions"]
          }
        ]
      },
      "skills": [
        {
          "id": "question-generation",
          "description": "Produce comprehension questions grounded in the source text",
          "inputModes": ["text"],
          "outputModes": ["text"]
        },
        {
          "id": "question-typing",
          "description": "Classify each generated question by cognitive type (factual, inferential, analytical, open-ended)",
          "inputModes": ["text"],
          "outputModes": ["text"]
        },
        {
          "id": "difficulty-calibration",
          "description": "Adjust the cognitive load of questions to match the requested difficulty level",
          "inputModes": ["text"],
          "outputModes": ["text"]
        }
      ],
      "capabilities": {
        "modalities": ["text"],
        "streaming": false
      }
    }
  ],

  "steps": [
    {
      "id": "step1",
      "agent": "language-translator-agent",
      "endpoint": "http://localhost:3011/agents/translator",
      "input": {
        "text": "${input.review}",
        "targetLang": "es"
      },
      "dependsOn": [],
      "rationale": "Traducir el review al español para que el equipo lo lea y para alimentar el generador de preguntas."
    },
    {
      "id": "step2",
      "agent": "sentiment-analyzer-agent",
      "endpoint": "http://localhost:3011/agents/sentiment",
      "input": {
        "text": "${input.review}"
      },
      "dependsOn": [],
      "rationale": "Confirmar polaridad y obtener score numérico sobre el texto ORIGINAL (más preciso en inglés)."
    },
    {
      "id": "step3",
      "agent": "category-classifier-agent",
      "endpoint": "http://localhost:3011/agents/classifier",
      "input": {
        "text": "${input.review}",
        "categories": ["product-quality", "shipping", "customer-service", "pricing", "other"]
      },
      "dependsOn": [],
      "rationale": "Clasificar el tipo de queja para routing al equipo correcto."
    },
    {
      "id": "step4",
      "agent": "question-generator-agent",
      "endpoint": "http://localhost:3011/agents/questioner",
      "input": {
        "text": "${step1.translation}",
        "count": 3,
        "difficulty": "medium"
      },
      "dependsOn": ["step1"],
      "rationale": "Generar preguntas en español (lengua del equipo de support) tras tener la traducción lista."
    }
  ],

  "executionLayers": [
    ["step1", "step2", "step3"],
    ["step4"]
  ],

  "finalOutput": {
    "translation_es": "${step1.translation}",
    "detected_source_lang": "${step1.detectedSourceLang}",
    "sentiment": "${step2.sentiment}",
    "sentiment_score": "${step2.score}",
    "sentiment_reasoning": "${step2.reasoning}",
    "complaint_category": "${step3.category}",
    "category_confidence": "${step3.confidence}",
    "alternative_categories": "${step3.alternatives}",
    "follow_up_questions": "${step4.questions}"
  }
}
